          "size": 18
        },
        "label": {
          "typography": {
            "fontSize": 12,
            "lineHeight": 15.6,
            "fontWeight": 700,
            "fontFamily": "Pretendard, Inter, sans-serif"
          },
          "fontWeight": 700,
          "lineHeight": 1.3
        }
      }
    }
  ],
  "motion": {
    "열림 · 닫힘": {
      "duration": "150ms",
      "easing": "cubic-bezier(0, 0, 0.15, 1)",
      "properties": [
        "transform"
      ],
      "note": "모션 줄이기면 바로 바꿉니다 — 끌기 따라가기는 모션이 아니라 그대로입니다"
    }
  },
  "notes": [
    {
      "rule": 0,
      "state": "enabled",
      "slot": "badge",
      "prop": "background",
      "note": "바탕은 배지에만 있습니다 — kind 별 값은 Kinds 표"
    },
    {
      "rule": 0,
      "state": "enabled",
      "slot": "action",
      "prop": "transform",
      "note": "누를 때 움직이지 않습니다 — 손가락으로 밀어 둔 트레이와 이중으로 움직이면 어지럽습니다"
    },
    {
      "rule": 0,
      "state": "focused",
      "slot": "focusRing",
      "prop": "offset",
      "note": "안쪽 — 트레이 바깥으로 나가면 줄 경계에서 잘립니다"
    },
    {
      "rule": 1,
      "state": "enabled",
      "slot": "badge",
      "prop": "background",
      "note": "줄 바탕과 1.08 · 다크 1.30 이라 안쪽 1px 테두리로 둘레를 잡습니다(배지는 아이콘 · 라벨로 읽힙니다)"
    },
    {
      "rule": 1,
      "state": "disabled",
