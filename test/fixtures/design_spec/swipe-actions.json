        "badge": {
          "borderColor": {
            "light": "#E5E8EF",
            "dark": "#404757"
          }
        }
      }
    },
    {
      "when": {
        "kind": "primary"
      },
      "enabled": {
        "badge": {
          "background": {
            "light": "#1D6EC9",
            "dark": "#69ABFF"
          }
        },
        "icon": {
          "color": {
