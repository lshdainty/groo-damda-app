          }
        },
        "label": {
          "color": {
            "light": "#535866",
            "dark": "#B7BDCC"
          }
        }
      }
    },
    {
      "when": {
        "kind": "destructive"
      },
      "enabled": {
        "badge": {
          "background": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        },
        "icon": {
          "color": {
            "light": "#FFFFFF",
            "dark": "#242938"
          }
        },
        "label": {
          "color": {
            "light": "#D72323",
            "dark": "#FF8477"
          }
        }
      }
